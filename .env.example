# --- Lapis vault ---
# Not needed if LOCAL_MODE=true below (see .env.example's Local mode section).
LAPIS_BASE_URL=https://lapis.dvenom.in
LAPIS_VAULT_ID=your-vault-id
# Auth: use ONE of these two. A device bearer token (same kind the Obsidian
# plugin uses) is strongly preferred for a headless script since it won't
# expire like a browser session cookie does. See README for how to get one.
LAPIS_BEARER_TOKEN=
LAPIS_SESSION_COOKIE=

# --- Where things live inside the vault (edit to match your actual layout) ---
LAPIS_PROJECTS_PREFIX=Projects/
LAPIS_WHATSAPP_PAGE_PATH=WhatsApp/ResearchDigest.md
LAPIS_COMMON_RESEARCH_PAGE_PATH=Interesting To Research.md
LAPIS_TRENDING_PAGE_PATH=Trending Feed.md
LAPIS_AGENT_LOG_PATH=Research Agent Log.md
LAPIS_STATE_PATH=Research/.agent-state.json

# --- OpenRouter (used for topic extraction + relevance judging) ---
OPENROUTER_API_KEY=
# Defaults to a free model (meta-llama/llama-3.3-70b-instruct:free) so this
# works with $0 OpenRouter credit. Any "provider/model" slug from
# https://openrouter.ai/models works — swap to a paid one if you want.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Caps every request's max_tokens — lower this if you switch to a paid
# model and hit 402 "requires more credits" errors.
OPENROUTER_MAX_TOKENS_CAP=4000
# Optional, used only for OpenRouter's public attribution/rankings.
OPENROUTER_SITE_URL=https://github.com/0xDevansh/lapis
OPENROUTER_APP_TITLE=Lapis Research Agent

# --- Hugging Face (optional, raises rate limits, not required) ---
HF_TOKEN=

# --- Behavior ---
# Force jobs 2/3 to run regardless of the 2-day floor, and force job 1 to
# run regardless of whether the WhatsApp page changed. Useful for testing.
FORCE_RUN=false
# When true, reads real data and runs the model as normal but never writes
# to Lapis (page edits and state saves are logged, not sent). Use this to
# test safely against your real vault. See README > Testing.
DRY_RUN=false

# --- Local mode (skip Lapis entirely) ---
# When true, every vault "page" the agent would read/write in Lapis becomes
# a plain file under LOCAL_OUTPUT_DIR on this machine instead — no Lapis
# connection needed at all. Good for trying out job 3 (trending) in
# isolation, since it doesn't touch project/WhatsApp pages. Job 1 needs a
# WhatsApp digest file to exist locally at that path under LOCAL_OUTPUT_DIR;
# job 2 needs project .md files under LOCAL_OUTPUT_DIR/Projects/.
# See README > Checking output on your laptop (no Lapis).
LOCAL_MODE=false
LOCAL_OUTPUT_DIR=./local-output
# Max trending HF papers to pull per run
HF_TRENDING_LIMIT=30
# Max HN stories to scan per run
HN_STORIES_LIMIT=80
# How many days back arXiv queries should look
ARXIV_LOOKBACK_DAYS=21
# Floor between full runs of jobs 2 (project-relevant) and 3 (trending)
MIN_DAYS_BETWEEN_PERIODIC_RUNS=2
# Max items kept in the trending feed page
TRENDING_FEED_SIZE=20
# How many already-pushed URLs / recent WhatsApp topics to remember, so the
# same paper is never re-pushed and job 3 knows what's already been discussed.
RECENT_URLS_MEMORY_SIZE=5000
RECENT_TOPICS_MEMORY_SIZE=100
